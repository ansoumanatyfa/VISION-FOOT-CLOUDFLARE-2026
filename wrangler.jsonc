{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vision-foot-affichage-tv",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_STATE",
        "class_name": "MatchState"
      }
    ]
  },
  "exports": {
    "MatchState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
